# Copiar este archivo como ".env" y completar SOLO el backend que vayas a usar.

# Backend a usar: anthropic | openai | gemini | cohere | mock
LLM_BACKEND=mock

# Modelo específico (opcional, cada backend tiene un default razonable)
# LLM_MODEL=claude-sonnet-4-6

# --- Completar solo la que corresponda al backend elegido ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# COHERE_API_KEY=...
